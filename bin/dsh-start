#!/bin/bash
# dsh-start — 一键启动 DSH 服务并输出带 token 的访问链接
# 用法：dsh-start  （或 DSH_SERVICE=服务名 dsh-start）
set -euo pipefail

SERVICE="${DSH_SERVICE:-dsh}"
TIMEOUT="${DSH_START_TIMEOUT:-30}"

# 解析访问地址（优先级：DSH_BASE_URL > /etc/dsh-url.conf > DSH_DOMAIN
# > 单元里的 --trusted-host（多个时优先选能解析的）> 本机回环）
CONF="${DSH_URL_CONF:-/etc/dsh-url.conf}"
PORT="${DSH_PORT:-}"
if [ -z "$PORT" ]; then
    PORT="$(systemctl cat "$SERVICE" 2>/dev/null | grep -oP -- '--port[ =]\K[0-9]+' | head -n1 || true)"
    if [ -z "$PORT" ]; then PORT=3080; fi
fi

BASE_URL=""
if [ -n "${DSH_BASE_URL:-}" ]; then
    BASE_URL="${DSH_BASE_URL%/}"
elif [ -r "$CONF" ]; then
    BASE_URL="$(grep -oP '^PUBLIC_BASE_URL=\K\S+' "$CONF" 2>/dev/null | head -n1 || true)"
    BASE_URL="${BASE_URL%/}"
elif [ -n "${DSH_DOMAIN:-}" ]; then
    BASE_URL="https://${DSH_DOMAIN%/}"
else
    HOSTS="$(systemctl cat "$SERVICE" 2>/dev/null | grep -oP -- '--trusted-host[ =]\K\S+' || true)"
    FIRST=""
    for h in $HOSTS; do
        case "$h" in *:*) continue ;; esac    # IP:端口 不能直接拼 https
        if [ -z "$FIRST" ]; then FIRST="$h"; fi
        if getent hosts "$h" >/dev/null 2>&1; then BASE_URL="https://$h"; break; fi
    done
    if [ -z "$BASE_URL" ] && [ -n "$FIRST" ]; then BASE_URL="https://$FIRST"; fi
fi
if [ -z "$BASE_URL" ]; then BASE_URL="http://127.0.0.1:$PORT"; fi

# 域名解析自检：拼出了域名却解析不到，多半是换了域名但单元/配置没同步
if [[ "$BASE_URL" == https://* ]]; then
    H="${BASE_URL#https://}"; H="${H%%/*}"; H="${H%%:*}"
    if ! getent hosts "$H" >/dev/null 2>&1; then
        echo "⚠️ 域名 $H 当前无法解析（DNS 未生效，或该域名已停用）。" >&2
        echo "   如已更换域名，执行：sudo dsh-domain 新域名" >&2
    fi
fi

if systemctl is-active --quiet "$SERVICE"; then
    echo "$SERVICE 已在运行，无需启动。获取链接请执行：dsh-url"
    exit 0
fi

echo "正在启动 $SERVICE ..."
systemctl start "$SERVICE"

# 轮询等待服务进入 active
STARTED=""
for _ in $(seq 1 "$TIMEOUT"); do
    if systemctl is-active --quiet "$SERVICE"; then
        STARTED="$(systemctl show "$SERVICE" -p MainPID --value)"
        break
    fi
    sleep 1
done

if [ -z "$STARTED" ] || [ "$STARTED" = "0" ]; then
    echo "❌ 启动失败：服务未能在 ${TIMEOUT}s 内就绪。最近日志：" >&2
    journalctl -u "$SERVICE" -n 15 --no-pager 2>/dev/null >&2 || true
    exit 1
fi
echo "✅ 服务已启动（PID=$STARTED）"

# 等待新进程打印 token（按本进程启动时间过滤）
SINCE="$(date -d "$(ps -o lstart= -p "$STARTED")" '+%Y-%m-%d %H:%M:%S' 2>/dev/null || true)"
TOKEN=""
for _ in $(seq 1 "$TIMEOUT"); do
    TOKEN="$(journalctl -u "$SERVICE" --since "$SINCE" --no-pager -o cat 2>/dev/null \
        | grep -oP 'token=\K[^[:space:]]+' | tail -n 1 || true)"
    [ -n "$TOKEN" ] && break
    sleep 1
done

if [ -n "$TOKEN" ]; then
    echo ""
    echo "🔗 访问链接："
    echo ""
    echo "${BASE_URL}/?token=${TOKEN}"
    echo ""
    echo "提示：重启不会使已登录设备的 cookie 失效（签名密钥持久化），"
    echo "     新链接用于新设备或 cookie 过期后登录。"
else
    echo "⚠️ 服务已启动，但 ${TIMEOUT}s 内未在日志中找到 token。" >&2
    echo "   稍后可执行：dsh-url 重新获取。" >&2
    exit 2
fi
