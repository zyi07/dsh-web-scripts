#!/bin/bash
# dsh-url — 输出当前 DSH Web 的带 token 访问链接
# 强化点：
#   1. 先检查服务是否在运行，避免拿到陈旧 token
#   2. 只匹配"当前进程"启动后打印的 token（按 MainPID 过滤 journal）
#   3. 访问地址多来源解析：DSH_BASE_URL > /etc/dsh-url.conf > DSH_DOMAIN
#      > 单元里的 --trusted-host（多个时优先选能解析的）> 本机回环
#   4. 域名解析不到时告警，提示用 dsh-domain 改域名（换域名后配置未同步的典型现象）
#   5. token 提取失败时给出针对性排查指引
set -euo pipefail

SERVICE="${DSH_SERVICE:-dsh}"
# 1. 服务必须在运行
if ! systemctl is-active --quiet "$SERVICE"; then
    echo "❌ 服务 $SERVICE 未运行。请先执行：dsh-restart" >&2
    exit 1
fi

# 2. 解析访问地址（优先级见文件头；/etc/dsh-url.conf 用于把"对外域名"与本机
#    systemd 单元的 --trusted-host 解耦，一台机器可挂多个域名）
CONF="${DSH_URL_CONF:-/etc/dsh-url.conf}"
PORT="${DSH_PORT:-}"
if [ -z "$PORT" ]; then
    PORT="$(systemctl cat "$SERVICE" 2>/dev/null | grep -oP -- '--port[ =]\K[0-9]+' | head -n1 || true)"
    if [ -z "$PORT" ]; then PORT=3080; fi
fi

BASE_URL=""
if [ -n "${DSH_BASE_URL:-}" ]; then
    BASE_URL="${DSH_BASE_URL%/}"
elif [ -r "$CONF" ]; then
    BASE_URL="$(grep -oP '^PUBLIC_BASE_URL=\K\S+' "$CONF" 2>/dev/null | head -n1 || true)"
    BASE_URL="${BASE_URL%/}"
elif [ -n "${DSH_DOMAIN:-}" ]; then
    BASE_URL="https://${DSH_DOMAIN%/}"
else
    HOSTS="$(systemctl cat "$SERVICE" 2>/dev/null | grep -oP -- '--trusted-host[ =]\K\S+' || true)"
    FIRST=""
    for h in $HOSTS; do
        case "$h" in *:*) continue ;; esac    # IP:端口 不能直接拼 https
        if [ -z "$FIRST" ]; then FIRST="$h"; fi
        if getent hosts "$h" >/dev/null 2>&1; then BASE_URL="https://$h"; break; fi
    done
    if [ -z "$BASE_URL" ] && [ -n "$FIRST" ]; then BASE_URL="https://$FIRST"; fi
fi
if [ -z "$BASE_URL" ]; then BASE_URL="http://127.0.0.1:$PORT"; fi

# 域名解析自检：拼出了域名却解析不到，多半是换了域名但单元/配置没同步
if [[ "$BASE_URL" == https://* ]]; then
    H="${BASE_URL#https://}"; H="${H%%/*}"; H="${H%%:*}"
    if ! getent hosts "$H" >/dev/null 2>&1; then
        echo "⚠️ 域名 $H 当前无法解析（DNS 未生效，或该域名已停用）。" >&2
        echo "   如已更换域名，执行：sudo dsh-domain 新域名" >&2
    fi
fi

# 3. 以当前 MainPID 启动时刻为界，只取该进程日志里的最新 token
#    （ps lstart 格式 journalctl 不认，先转成标准时间戳）
MAIN_PID="$(systemctl show "$SERVICE" -p MainPID --value)"
SINCE="$(date -d "$(ps -o lstart= -p "$MAIN_PID" 2>/dev/null || true)" '+%Y-%m-%d %H:%M:%S' 2>/dev/null || true)"
if [ -z "$SINCE" ]; then
    echo "❌ 无法读取 $SERVICE 主进程（PID=$MAIN_PID）" >&2
    exit 1
fi

TOKEN="$(journalctl -u "$SERVICE" --since "$SINCE" --no-pager -o cat 2>/dev/null \
    | grep -oP 'token=\K[^[:space:]]+' | tail -n 1 || true)"

if [ -z "$TOKEN" ]; then
    echo "⚠️ 未在当前进程日志中找到 token。" >&2
    echo "   可能原因：服务启动后尚未打印链接，或 stdout 未进入 journal。" >&2
    echo "   排查命令：journalctl -u $SERVICE --since \"$SINCE\" --no-pager | grep 'dsh web:'" >&2
    exit 2
fi

echo ""
echo "🔗 当前 DSH 访问链接："
echo ""
echo "${BASE_URL}/?token=${TOKEN}"
echo ""
echo "提示：该 token 只在当前进程存活期间有效，重启后会更换；"
echo "     首次打开后会换取 30 天有效的浏览器 cookie，之后直接访问该地址即可。"
