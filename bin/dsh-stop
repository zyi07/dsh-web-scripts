#!/bin/bash
# dsh-stop — 一键停止 DSH 服务
# 用法：dsh-stop  （或 DSH_SERVICE=服务名 dsh-stop）
set -euo pipefail

SERVICE="${DSH_SERVICE:-dsh}"

if ! systemctl is-active --quiet "$SERVICE"; then
    echo "$SERVICE 未在运行，无需停止。"
    exit 0
fi

echo "⚠️  提示：若你正在 DSH 网页会话里执行本命令，这条连接会随服务停止立即中断（属预期现象），建议从 SSH 终端执行。"
echo "正在停止 $SERVICE ..."
systemctl stop "$SERVICE"

# 确认真停了（Restart=always 只对"失败退出"生效，显式 stop 不会被拉起）
for _ in $(seq 1 10); do
    systemctl is-active --quiet "$SERVICE" || break
    sleep 0.5
done

if systemctl is-active --quiet "$SERVICE"; then
    echo "❌ 停止失败，请检查：systemctl status $SERVICE" >&2
    exit 1
fi

echo "✅ $SERVICE 已停止"
echo "   说明：显式 stop 后 systemd 不会自动拉起；要再次启动请执行：dsh-start"
